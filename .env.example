# Only needed once you switch the data layer from mock data to PostgreSQL (see README).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/dsa_mastery?schema=public"

# Optional: a real code-execution backend (e.g. a self-hosted Judge0 instance).
# When unset, non-JavaScript runs use the simulated judge in src/lib/execution/mock-judge.ts.
EXECUTION_API_URL=""
EXECUTION_API_KEY=""
